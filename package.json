{
  "name": "legal-document-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "ngc -p tsconfig.app.json && sass client/styles.scss dist/styles.css --load-path=node_modules --no-source-map --silence-deprecation=import && webpack --config webpack.config.cjs",
    "start": "node dist/server/main.js",
    "dev": "npm run build && npm start",
    "db:migrate": "npm run build:server && node dist/server/migrate.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && ngc -p tsconfig.app.json --noEmit",
    "format": "prettier --write server client tests *.json *.cjs *.ts docs README.md",
    "format:check": "prettier --check server client tests *.json *.cjs *.ts docs README.md",
    "demo:pdf": "node scripts/demo-pdf.mjs"
  },
  "dependencies": {
    "@angular/animations": "19.2.25",
    "@angular/cdk": "19.2.19",
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/material": "19.2.19",
    "@angular/platform-browser": "19.2.25",
    "@angular/router": "19.2.25",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@langchain/textsplitters": "^1.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "pdfjs-dist": "6.4.299",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/compiler-cli": "19.2.25",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "pdfkit": "^0.17.2",
    "prettier": "^3.6.0",
    "sass": "^1.93.0",
    "supertest": "^7.1.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.12",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
